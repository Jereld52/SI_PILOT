# Copier vers infra/.env et renseigner avant docker compose -f infra/compose.prod.yml up -d

POSTGRES_DB=si_pnfor
POSTGRES_USER=pnfor
POSTGRES_PASSWORD=change-me-with-a-strong-random-password

# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-with-a-long-random-value-at-least-32-chars

# Chiffrement des PIN/PUK des lignes mobiles.
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# À sauvegarder séparément : sans cette clé, les secrets sont irrécupérables.
FIELD_ENCRYPTION_KEY=

# Origine publique de l'application (accès direct ou reverse proxy HTTPS)
CORS_ORIGINS=http://localhost:8080

# Passer à true derrière HTTPS
SECURE_COOKIES=false

# Port publié par Nginx
WEB_PORT=8080
