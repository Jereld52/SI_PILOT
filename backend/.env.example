# SI PNFor PILOTE - configuration locale
# Copier vers .env et renseigner les valeurs. Ne jamais committer .env.

APP_NAME="SI PNFor PILOTE"
APP_ENV=development
DEBUG=false
APP_VERSION=0.1.0

# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-with-a-long-random-value-at-least-32-chars

# PostgreSQL local portable (port 5433) ou PostgreSQL dédié
DATABASE_URL=postgresql+psycopg://pnfor:change-me@127.0.0.1:5433/si_pnfor

# Origines autorisées pour le frontend de développement
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

SESSION_COOKIE_NAME=pnfor_session
CSRF_COOKIE_NAME=pnfor_csrf
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_DAYS=7
SECURE_COOKIES=false
# true uniquement derrière un reverse proxy de confiance (Nginx/Caddy)
TRUST_PROXY_HEADERS=false

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# Mode natif Windows : servir le frontend compilé depuis FastAPI.
# Laisser false en développement (Vite) et en Docker (Nginx).
SERVE_FRONTEND=false
FRONTEND_DIST=../frontend/dist

# SylvIA / Open WebUI / Ollama - désactivé par défaut
SYLVIA_ENABLED=false
SYLVIA_BASE_URL=
SYLVIA_API_KEY=
SYLVIA_MODEL=
SYLVIA_TIMEOUT_SECONDS=30
SYLVIA_VERIFY_TLS=true

# Amorçage initial uniquement (compte admin). Vider après usage.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
